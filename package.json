{
	"name": "semantic-scholar-bridge",
	"version": "0.2.1",
	"description": "Shares one Semantic Scholar API key with a group of users: authentication (OIDC or Zotero group), rate limiting, caching",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.4",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"jose": "^6.2.12"
	}
}
