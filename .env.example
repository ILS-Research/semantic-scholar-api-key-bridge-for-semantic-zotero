# Semantic Scholar key shared by all users (https://www.semanticscholar.org/product/api#api-key-form)
S2_API_KEY=
# S2_BASE_URL=https://api.semanticscholar.org

# Who may use the bridge: oidc, zotero-group, or both (comma-separated)
AUTH=oidc

# --- AUTH=oidc: access tokens of an OIDC provider (e.g. Keycloak), checked against its JWKS
OIDC_ISSUER=https://keycloak.example.org/realms/example
# Client ID(s) the tokens are issued for (aud or azp), comma-separated
OIDC_AUDIENCE=semantic-zotero
# Optional: access level per client (papers | papers+authors); others get papers. E.g. for an MCP server:
# OIDC_AUDIENCE=semantic-zotero,openwebui
# OIDC_CLIENT_SCOPES=openwebui:papers+authors
# Optional: any of these roles (realm or client) or groups is required
# OIDC_REQUIRED_ROLES=s2-users
# OIDC_REQUIRED_GROUPS=/staff

# --- AUTH=zotero-group: Zotero API key of a member of one of these groups
# ZOTERO_GROUP_IDS=1234567
# ZOTERO_API_URL=https://api.zotero.org

# Limits (defaults shown)
# RATE_PER_SEC=1
# MAX_QUEUED_PER_USER=10
# QUEUE_TIMEOUT_SEC=60
# RETRY_BUDGET_SEC=30
# CACHE_TTL_SEC=86400
# CACHE_NOT_FOUND_TTL_SEC=3600
# CACHE_MAX_MB=256
# AUTH_CACHE_SEC=300
# STATUS_PAGE=true
# Header with the client address, set by the proxy in front (sent to the Zotero API as Zotero-Forwarded-For)
# CLIENT_IP_HEADER=x-real-ip
